# OWNER: Yến
# ============================================================
# Quiz & Exam Practice API - BIẾN MÔI TRƯỜNG MẪU
# OWNER: Bùi Ngọc Yến
# ------------------------------------------------------------
# Cách dùng:
#   Windows     : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# Sau đó mở .env và điền giá trị thật.
# KHÔNG commit file .env lên GitHub (đã chặn trong .gitignore).
# ============================================================

# ---------- Server ----------
# Cổng lắng nghe của Express
PORT=3000
# development | production | test
NODE_ENV=development

# ---------- Database: SQL Server 2022 Express ----------
# Tên máy chủ: localhost, .\SQLEXPRESS hoặc tên máy trong SSMS
DB_SERVER=localhost
# Cổng mặc định của SQL Server (KHÔNG phải 3306 của MySQL)
DB_PORT=1433
# Tên database, chạy database/01_create_tables.sql sẽ tạo ra
DB_NAME=QuizExam
# Tài khoản đăng nhập SQL Server (không dùng Windows Auth)
DB_USER=sa
# Mật khẩu tài khoản ở trên - điền mật khẩu thật của máy bạn
DB_PASSWORD=YourStrong@Passw0rd
# true khi dùng SQL Server Express với chứng chỉ tự ký
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Connection pool
DB_POOL_MIN=0
DB_POOL_MAX=10
# Timeout (ms) - nên lớn hơn thời gian chạy Stored Procedure chấm điểm
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# ---------- Xác thực JWT ----------
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên >= 32 ký tự trước khi chạy production
# Sinh chuỗi mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=doi_chuoi_nay_thanh_bi_mat_ngau_nhien_it_nhat_32_ky_tu
# Thời hạn token: 2h (mặc định theo CONTRACT.md)
JWT_EXPIRES_IN=2h

# ---------- Băm mật khẩu ----------
BCRYPT_SALT_ROUNDS=10

# ---------- Google Gemini (tùy chọn - giải thích câu sai) ----------
# Lấy key tại https://aistudio.google.com/apikey . Để trống thì hệ thống
# vẫn chấm điểm bình thường, chỉ thiếu phần lời giải AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Timeout mỗi lần gọi Gemini (ms) - phải nhỏ hơn timeout của request
GEMINI_TIMEOUT_MS=10000

# ---------- CORS ----------
# Domain của frontend được phép gọi API, nhiều domain cách nhau bởi dấu phẩy
CORS_ORIGIN=http://localhost:5173
